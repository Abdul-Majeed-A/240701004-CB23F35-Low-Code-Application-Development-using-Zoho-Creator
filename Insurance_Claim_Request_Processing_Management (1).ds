		workflow
		{
		form
		{
			auto_assign_surveyor as "Auto-Assign Surveyor on Claim"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Fetch surveyor records based on claim type
										surveyorRecords = Surveyor_Profile[branch == "default"];
										// Check if surveyor records exist
										if(surveyorRecords.count() > 0)
										{
											// Get the first surveyor record
											firstSurveyor = surveyorRecords;
											// Set the surveyor_assigned field with the surveyor's name
											input.surveyor_assigned = firstSurveyor.surveyor_name.first_name + " " + firstSurveyor.surveyor_name.last_name;
										}
										else
										{
											// Clear the field if no surveyor is found
											input.surveyor_assigned = "";
										}
						)
					}
				}

			}
			block_high_value_claims as "Block High Value Claims"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if claim amount exceeds 100,000
										if(input.claim_amount_requested > 100000)
										{
											// Display error message to user
											alert "Claim amount exceeds 100,000. Manager approval is required before submission.";
											// Cancel the form submission
											cancel submit;
										}
						)
					}
				}

			}
			notify_team_status_change as "Notify Team on Status Change"
			{
				type =  form
				form = Claim_Request_Form

				record event = on edit

				on user input of investigation_status
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the Claims Processing Team records
										claimsTeam = Claims_Processing_Team[ID != 0];
										// Check if investigation status has changed to 'In Progress' or 'Completed'
										if(input.investigation_status == "In Progress" || input.investigation_status == "Completed")
										{
											// Prepare notification message
											claimID = input.ID;
											claimantName = input.claimant_name.first_name.concat(" ").concat(input.claimant_name.last_name);
											claimAmount = input.claim_amount_requested.toString();
											input.status = input.investigation_status;
											notificationMessage = "<p>Dear Claims Team,</p>";
											notificationMessage = notificationMessage.concat("<p>A claim has been updated with the following details:</p>");
											notificationMessage = notificationMessage.concat("<ul>");
											notificationMessage = notificationMessage.concat("<li><strong>Claim ID:</strong> " + claimID + "</li>");
											notificationMessage = notificationMessage.concat("<li><strong>Claimant:</strong> " + claimantName + "</li>");
											notificationMessage = notificationMessage.concat("<li><strong>Claim Amount:</strong> " + claimAmount + "</li>");
											notificationMessage = notificationMessage.concat("<li><strong>Investigation Status:</strong> " + input.status + "</li>");
											notificationMessage = notificationMessage.concat("</ul>");
											notificationMessage = notificationMessage.concat("<p>Please review the claim accordingly.</p>");
											// Send notification to each team member
											for each  teamMember in claimsTeam
											{
												sendmail
												[
													from :zoho.loginuserid
													to :teamMember.email
													subject :"Investigation Status Update - Claim " + claimID
													message :notificationMessage
													content type :HTML
												]
											}
										}
						)
					}
				}

			}
		}

		schedule
		{
			weekly_pending_claims_report as "Weekly Pending Claims Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch pending claims from Claim_Request_Form
										pendingClaims = Claim_Request_Form[status in {"Submitted","Under Investigation","Pending"}];
										// Check if there are any pending claims
										if(pendingClaims.count() > 0)
										{
											// Initialize summary string
											summaryText = "Weekly Summary of Pending Claims\n\n";
											summaryText = summaryText.concat("Total Pending Claims: ").concat(pendingClaims.count().toString()).concat("\n\n");
											// Iterate through each pending claim to build details
											for each  claim in pendingClaims
											{
												claimDetails = "Claim ID: ";
												claimDetails = claimDetails.concat(claim.ID.toString()).concat("\n");
												claimDetails = claimDetails.concat("Policy Number: ").concat(claim.policy_number).concat("\n");
												claimDetails = claimDetails.concat("Claim Type: ").concat(claim.claim_type).concat("\n");
												claimDetails = claimDetails.concat("Claim Amount: ").concat(claim.claim_amount_requested.toString()).concat("\n");
												claimDetails = claimDetails.concat("Status: ").concat(claim.status).concat("\n");
												claimDetails = claimDetails.concat("Submitted On: ").concat(toString(claim.claim_submitted_on,"MMM dd, yyyy","UTC")).concat("\n");
												claimDetails = claimDetails.concat("------------------------\n");
												summaryText = summaryText.concat(claimDetails);
											}
											// Send email to senior management
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.adminuserid
												subject :"Weekly Summary of Pending Claims"
												message :summaryText
												content type :Plain Text
											]
										}
										else
										{
											// Send notification if no pending claims
											sendmail
											[
												from :zoho.loginuserid
												to :zoho.adminuserid
												subject :"Weekly Summary of Pending Claims - No Pending Claims"
												message :"There are no pending claims this week."
												content type :Plain Text
											]
										}
					)
					}
				}
			}
		}




