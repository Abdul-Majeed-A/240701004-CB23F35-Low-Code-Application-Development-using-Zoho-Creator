 application "Insurance Claim Request Processing System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form approval_record
		{
			displayname = "Approval Record"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_reference
			(
				type = list	
				displayname = "Claim Reference"
				values  = claim_request.ID
    			displayformat = [claim_reference_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approver_name
			(
    			type = text
				displayname = "Approver Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_action
			(
				type = radiobuttons
				displayname = "Approval Action"
				values = {"Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_comment
			(
    			type = textarea
				displayname = "Approval Comment"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_time
			(
    			type = datetime
				displayname = "Approval Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_fallback_used
			(
    			type = checkbox
				displayname = "Is Fallback Used"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form claim_request
		{
			displayname = "Claim Request"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_reference_id
			(
    			type = autonumber
				displayname = "Claim Reference ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_email
			(
    			type = email
				displayname = "Claimant Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_phone
			(
    			type = phonenumber
				displayname = "Claimant Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_address
			(
    			type = address
				displayname = "Claimant Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_date
			(
    			type = date
				displayname = "Incident Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_repair_cost
			(
				displayname = "Estimated Repair Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			depreciation_percent
			(
    			type = percentage
				displayname = "Depreciation Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_amount
			(
				displayname = "Net Payable Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","Document Verification","Investigation","Pending Senior Approval","Approved","Rejected","Settled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			settlement_status
			(
				type = picklist
				displayname = "Settlement Status"
				values = {"Not Initiated","Failed","Paid","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_document_complete
			(
    			type = checkbox
				displayname = "Is Document Complete"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			missing_documents_count
			(
				type = number
				displayname = "Missing Documents Count"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			surveyor_report_id
			(
    			type = autonumber
				displayname = "Surveyor Report ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			transaction_reference
			(
    			type = text
				displayname = "Transaction Reference"
	 			row = 1
	 			column = 1   
				width = medium
			)
			approval_comment
			(
    			type = textarea
				displayname = "Approval Comment"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_by
			(
    			type = text
				displayname = "Created By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			created_time
			(
    			type = datetime
				displayname = "Created Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_by
			(
    			type = text
				displayname = "Last Modified By"
	 			row = 1
	 			column = 1   
				width = medium
			)
			last_modified_time
			(
    			type = datetime
				displayname = "Last Modified Time"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Claim Under Review","Claim Rejected","Pending Documentation","Claim Assigned to Surveyor","Claim Approved","Survey In Progress","Survey Report Submitted","Pending Payment","Claim Settled","Claim Closed"}
			}
		}
