	reports
	{
		list claim_document_Report
		{
			displayName = "All Documents"
			show all rows from claim_document    
			(
				claim as "Claim Request"
				document_type as "Document Type"
				file_url as "File URL"
				upload_date as "Upload Date"
				uploaded_by as "Uploaded By"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (document_type == "FIR Copy")
				fields = [document_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (document_type == "Medical Report")
				fields = [document_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (document_type == "Police Report")
				fields = [document_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban claim_document_by_document_type
		{
			displayName = "Document Types"
			show all rows from claim_document    
			(
				claim as "Claim Request"
				document_type as "Document Type"
				file_url as "File URL"
				upload_date as "Upload Date"
				uploaded_by as "Uploaded By"
			)
			options
			(
	 			display field = document_type
	 		)
		}
		list reminder_log_Report
		{
			displayName = "Reminder Log Report"
			show all rows from reminder_log    
			(
				claim as "Claim Request"
				sent_date as "Sent Date"
				recipient_email as "Recipient Email"
				reminder_status as "Reminder Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (reminder_status == "Delivered")
				fields = [reminder_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (reminder_status == "Failed")
				fields = [reminder_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (reminder_status == "Opened")
				fields = [reminder_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban reminder_log_by_reminder_status
		{
			displayName = "Reminder Statuses"
			show all rows from reminder_log    
			(
				claim as "Claim Request"
				sent_date as "Sent Date"
				recipient_email as "Recipient Email"
				reminder_status as "Reminder Status"
			)
			options
			(
	 			display field = reminder_status
	 		)
		}
		list reserve_fund_snapshot_Report
		{
			displayName = "All Reserve Fund Snapshots"
			show all rows from reserve_fund_snapshot    
			(
				branch as "Branch"
				snapshot_date as "Snapshot Date"
				total_exposure as "Total Exposure"
				(
					display = total,average,min,max	
				)
				available_funds as "Available Funds"
				(
					display = total,average,min,max	
				)
			)
		}
		list surveyor_Report
		{
			displayName = "All Surveyors"
			show all rows from surveyor    
			(
				name  as "Name"
				email as "Email"
				phone_number as "Phone Number"
				current_availability as "Current Availability"
				assigned_branch as "Assigned Branch"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (current_availability == "Available")
				fields = [current_availability]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (current_availability == "On Site")
				fields = [current_availability]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (current_availability == "Unavailable")
				fields = [current_availability]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban surveyor_by_current_availability
		{
			displayName = "Current Availabilities"
			show all rows from surveyor    
			(
				name  as "Name"
				email as "Email"
				phone_number as "Phone Number"
				current_availability as "Current Availability"
				assigned_branch as "Assigned Branch"
			)
			options
			(
	 			display field = current_availability
	 		)
		}
		list claim_request_Report
		{
			displayName = "All Requests"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				policy_number as "Policy Number"
