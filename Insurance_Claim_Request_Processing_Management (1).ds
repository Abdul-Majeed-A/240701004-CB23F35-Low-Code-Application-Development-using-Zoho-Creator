		form Claim_Request_Form
		{
			displayname = "Claim Request Form"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_type
			(
				type = picklist
				displayname = "Claim Type"
				values = {"Vehicle","Travel","Health","Life","Property","Other"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_type
			(
				type = picklist
				displayname = "Claimant Type"
				values = {"Nominee","Policyholder","Third Party"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_amount_requested
			(
				displayname = "Claim Amount Requested"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_incident
			(
    			type = date
				displayname = "Date Of Incident"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_submitted_on
			(
    			type = datetime
				displayname = "Claim Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			investigation_status
			(
				type = picklist
				displayname = "Investigation Status"
				values = {"Completed","In Progress","Pending"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			surveyor_assigned
			(
    			type = text
				displayname = "Surveyor Assigned"
	 			row = 1
	 			column = 1   
				width = medium
			)
			settlement_status
			(
				type = picklist
				displayname = "Settlement Status"
				values = {"Not Started","In Negotiation","Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","Under Investigation","Approved","Rejected","Settled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Claim Under Review","Claim Rejected","Surveyor Assigned","Claim Pending Information","Investigation In Progress","Investigation Complete","Claim Approved","Claim Denied","Settlement Processing","Settlement Completed","Settlement On Hold","Claim Closed"}
			}
		}
