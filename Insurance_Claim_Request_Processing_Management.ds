 application "Insurance Claim Request Processing Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form branch
		{
			displayname = "Branch"
			success message = "Branch Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			branch_id
			(
    			type = autonumber
				displayname = "Branch ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_name
			(
    			type = text
				displayname = "Branch Name"
	 			row = 1
	 			column = 1   
				width = medium
			)
			monthly_settlement_target
			(
				displayname = "Monthly Settlement Target"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			current_reserve_fund
			(
				displayname = "Current Reserve Fund"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			manager
			(
    			type = text
				displayname = "Manager"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form claim_document
		{
			displayname = "Claim Document"
			success message = "Document Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim
			(
				type = list	
				displayname = "Claim Request"
				values  = claim_request.ID
    			displayformat = [claim_reference_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			document_type
			(
				type = picklist
				displayname = "Document Type"
				values = {"Medical Report","Repair Estimate","FIR Copy","Police Report"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			file_url
			(
    			type = url
				displayname = "File URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			upload_date
			(
    			type = datetime
				displayname = "Upload Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			uploaded_by
			(
    			type = text
				displayname = "Uploaded By"
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form claim_request
		{
			displayname = "Claim Request"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_reference_id
			(
    			type = autonumber
				displayname = "Claim Reference ID"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_type
			(
				type = picklist
				displayname = "Claim Type"
				values = {"Vehicle","Liability","Health","Life","Property"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = picklist
				displayname = "Status"
				values = {"Submitted","Under Investigation","Approved","Rejected","Settled"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_amount
			(
				displayname = "Claim Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			submission_date
			(
    			type = date
				displayname = "Submission Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			settlement_date
			(
    			type = date
				displayname = "Settlement Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			missing_documents_flag
			(
    			type = checkbox
				displayname = "Missing Documents Flag"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			fir_document_url
			(
    			type = url
				displayname = "FIR Document URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			repair_estimate_url
			(
    			type = url
				displayname = "Repair Estimate URL"
	 			row = 1
	 			column = 1   
				width = medium
			)
			surveyor_assigned
			(
    			type = text
				displayname = "Surveyor Assigned"
	 			row = 1
	 			column = 1   
				width = medium
			)
			branch_manager
			(
    			type = text
				displayname = "Branch Manager"
	 			row = 1
	 			column = 1   
				width = medium
			)
			notes
			(
    			type = textarea
				displayname = "Notes"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Submitted","Initial Review","Claim Rejected","Surveyor Assigned","Missing Documents","Investigation In Progress","Repair Estimate Pending","Settlement Negotiation","Settlement Agreed","Payment Processing","Claim Closed","Payment Failed"}
			}
		}
