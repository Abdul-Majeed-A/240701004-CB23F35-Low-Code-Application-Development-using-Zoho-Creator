			{
				name = "Policy Administrator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Maintain accurate policy data and coverage limits within the system \n"
				ModulePermissions
				{
