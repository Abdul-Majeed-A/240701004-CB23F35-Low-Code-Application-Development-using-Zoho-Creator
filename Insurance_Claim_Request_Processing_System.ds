	reports
	{
		list surveyor_report_Report
		{
			displayName = "Surveyor Report Report"
			show all rows from surveyor_report    
			(
				claim_reference as "Claim Reference"
				surveyor_name  as "Surveyor Name"
				survey_date as "Survey Date"
				surveyor_estimate as "Surveyor Estimate"
				(
					display = total,average,min,max	
				)
				discrepancy_flag as "Discrepancy Flag"
				discrepancy_notes as "Discrepancy Notes"
				report_file_url as "Report File URL"
				uploaded_by as "Uploaded By"
				upload_time as "Upload Time"
			)
		}
		list approval_record_Report
		{
			displayName = "Approval Record Report"
			show all rows from approval_record    
			(
				claim_reference as "Claim Reference"
				approver_name as "Approver Name"
				approval_action as "Approval Action"
				approval_comment as "Approval Comment"
				approval_time as "Approval Time"
				is_fallback_used as "Is Fallback Used"
			)
		}
		list workflow_error_log_Report
		{
			displayName = "Workflow Error Log Report"
			show all rows from workflow_error_log    
			(
				workflow_name as "Workflow Name"
				claim_reference as "Claim Reference"
				error_message as "Error Message"
				error_time as "Error Time"
				retry_count as "Retry Count"
			)
		}
		list claimant_profile_Report
		{
			displayName = "Claimant Profile Report"
			show all rows from claimant_profile    
			(
				claimant_name  as "Claimant Name"
				email as "Email"
				phone_number as "Phone Number"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				bank_account_number as "Bank Account Number"
				bank_name as "Bank Name"
				ifsc_code as "IFSC Code"
				is_active as "Is Active"
			)
		}
		list settlement_letter_log_Report
		{
			displayName = "Settlement Letter Log Report"
			show all rows from settlement_letter_log    
			(
				claim_reference as "Claim Reference"
				letter_generation_time as "Letter Generation Time"
				trigger_source as "Trigger Source"
				email_sent_status as "Email Sent Status"
				pdf_url as "PDF URL"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (trigger_source == "Batch-Audit")
				fields = [trigger_source]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (trigger_source == "Manual-Resend")
				fields = [trigger_source]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban settlement_letter_log_by_trigger_source
		{
			displayName = "Trigger Source"
			show all rows from settlement_letter_log    
			(
				claim_reference as "Claim Reference"
				letter_generation_time as "Letter Generation Time"
				trigger_source as "Trigger Source"
				email_sent_status as "Email Sent Status"
				pdf_url as "PDF URL"
			)
			options
			(
	 			display field = trigger_source
	 		)
		}
		list claim_request_Report
		{
			displayName = "Claim Request Report"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_email as "Claimant Email"
				claimant_phone as "Claimant Phone"
				claimant_address  as "Claimant Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				incident_date as "Incident Date"
				incident_description as "Incident Description"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				status as "Status"
				settlement_status as "Settlement Status"
				is_document_complete as "Is Document Complete"
				missing_documents_count as "Missing Documents Count"
				surveyor_report_id as "Surveyor Report ID"
				transaction_reference as "Transaction Reference"
				approval_comment as "Approval Comment"
				created_by as "Created By"
				created_time as "Created Time"
				last_modified_by as "Last Modified By"
				last_modified_time as "Last Modified Time"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (settlement_status == "Failed")
				fields = [settlement_status]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (settlement_status == "Not Initiated")
				fields = [settlement_status]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (settlement_status == "Pending")
				fields = [settlement_status]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban claim_request_by_status
		{
			displayName = "Status"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				claimant_email as "Claimant Email"
				claimant_phone as "Claimant Phone"
				claimant_address  as "Claimant Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				incident_date as "Incident Date"
				incident_description as "Incident Description"
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				status as "Status"
				settlement_status as "Settlement Status"
				is_document_complete as "Is Document Complete"
				missing_documents_count as "Missing Documents Count"
				surveyor_report_id as "Surveyor Report ID"
				transaction_reference as "Transaction Reference"
				approval_comment as "Approval Comment"
				created_by as "Created By"
				created_time as "Created Time"
				last_modified_by as "Last Modified By"
				last_modified_time as "Last Modified Time"
			)
			options
			(
	 			display field = status
	 		)
		}
	}
