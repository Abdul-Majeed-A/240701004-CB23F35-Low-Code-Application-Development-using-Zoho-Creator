 application "Insurance Claim Request Processing System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form claim_request
		{
			displayname = "Claim Request"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_email
			(
    			type = email
				displayname = "Contact Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_phone
			(
    			type = phonenumber
				displayname = "Contact Phone"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			is_third_party_involved
			(
    			type = checkbox
				displayname = "Is Third Party Involved"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_process_guidelines_display
			(
    			type = textarea
				displayname = "Claim Process Guidelines Display"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			fir_copy_online_link
			(
    			type = url
				displayname = "FIR Copy Online Link"
	 			row = 1
	 			column = 1   
				width = medium
			)
			damage_photo
			(
    			type = text
				displayname = "Damage Photo"
	 			row = 1
	 			column = 1   
				width = medium
			)
			depreciation_percent
			(
    			type = percentage
				displayname = "Depreciation Percent"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			estimated_repair_cost
			(
				displayname = "Estimated Repair Cost"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_sum_insured_lakhs
			(
				type = decimal
				displayname = "Policy Sum Insured Lakhs"
				maxchar = 16
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_submitted_on
			(
    			type = datetime
				displayname = "Claim Submitted On"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_reference_id
			(
    			type = autonumber
				displayname = "Claim Reference Id"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_payable_amount
			(
				displayname = "Net Payable Amount"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_tracking_qr_code
			(
    			type = text
				displayname = "Claim Tracking QR Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_digital_signature
			(
    			type = text
				displayname = "Claimant Digital Signature"
	 			row = 1
	 			column = 1   
				width = medium
			)
			repair_estimate_upload
			(
    			type = text
				displayname = "Repair Estimate Upload"
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_voice_statement
			(
    			type = text
				displayname = "Incident Voice Statement"
	 			row = 1
	 			column = 1   
				width = medium
			)
			accident_scene_video
			(
    			type = text
				displayname = "Accident Scene Video"
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_details_lookup
			(
				type = list	
				displayname = "Policy Details Lookup"
				values  = policies.ID
    			displayformat = [policy_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Initiated","Claim Under Review","Claim Draft","Claim Approved","Claim Rejected","Claim Pending Verification","Claim Escalated","Claim Payment Processing","Claim Closed","Claim Paid","Claim Payment Failed"}
			}
		}
		form policies
		{
			displayname = "Master Policies"
			success message = "Master Policies Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			policy_id
			(
    			type = text
				displayname = "Policy Id"
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_holder_name
			(
    			type = name
				displayname = "Policy Holder Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			coverage_type
			(
				type = picklist
				displayname = "Coverage Type"
				values = {"Third Party","Standalone","Comprehensive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			sum_insured
			(
				displayname = "Sum Insured"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			validity_date
			(
    			type = date
				displayname = "Validity Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_deductible
			(
				displayname = "Policy Deductible"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form witness_details
		{
			displayname = "Witness Details"
			success message = "Witness Details Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claim_request
			(
				type = list	
				displayname = "Claim Request"
				values  = claim_request.ID
    			displayformat = [claim_reference_id]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_name
			(
    			type = name
				displayname = "Witness Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_contact
			(
    			type = phonenumber
				displayname = "Witness Contact"
	 			row = 1
	 			column = 1   
				width = medium
			)
			witness_statement
			(
    			type = textarea
				displayname = "Witness Statement"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Witness Record Created","Pending Verification","Record Rejected","Verification In Progress","Verification Approved","Verification Failed","Evidence Integrated","Pending Review","Case Closed"}
			}
		}
	}
	reports
	{
		list claim_request_Report
		{
			displayName = "All Requests"
			show all rows from claim_request    
			(
				claimant_name  as "Claimant Name"
				contact_email as "Contact Email"
				contact_phone as "Contact Phone"
				incident_description as "Incident Description"
				is_third_party_involved as "Is Third Party Involved"
				claim_process_guidelines_display as "Claim Process Guidelines Display"
				fir_copy_online_link as "FIR Copy Online Link"
				damage_photo as "Damage Photo"
				depreciation_percent as "Depreciation Percent"
				(
					display = total,average,min,max	
				)
				estimated_repair_cost as "Estimated Repair Cost"
				(
					display = total,average,min,max	
				)
				policy_sum_insured_lakhs as "Policy Sum Insured Lakhs"
				claim_submitted_on as "Claim Submitted On"
				claim_reference_id as "Claim Reference Id"
				net_payable_amount as "Net Payable Amount"
				(
					display = total,average,min,max	
				)
				claim_tracking_qr_code as "Claim Tracking QR Code"
				claimant_digital_signature as "Claimant Digital Signature"
				repair_estimate_upload as "Repair Estimate Upload"
				incident_voice_statement as "Incident Voice Statement"
				accident_scene_video as "Accident Scene Video"
				policy_details_lookup as "Policy Details Lookup"
			)
		}
		list witness_details_Report
		{
			displayName = "All Witness Details"
			show all rows from witness_details    
			(
				claim_request as "Claim Request"
				witness_name  as "Witness Name"
				witness_contact as "Witness Contact"
				witness_statement as "Witness Statement"
			)
		}
		list policies_Report
		{
			displayName = "All Master Policies"
			show all rows from policies    
			(
				policy_id as "Policy Id"
				policy_holder_name  as "Policy Holder Name"
				coverage_type as "Coverage Type"
				sum_insured as "Sum Insured"
				(
					display = total,average,min,max	
				)
				validity_date as "Validity Date"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (coverage_type == "Comprehensive")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (coverage_type == "Standalone")
				fields = [coverage_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (coverage_type == "Third Party")
				fields = [coverage_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban policies_by_coverage_type
		{
			displayName = "Coverage Types"
			show all rows from policies    
			(
				policy_id as "Policy Id"
				policy_holder_name  as "Policy Holder Name"
				coverage_type as "Coverage Type"
				sum_insured as "Sum Insured"
				(
					display = total,average,min,max	
				)
				validity_date as "Validity Date"
				policy_deductible as "Policy Deductible"
				(
					display = total,average,min,max	
				)
			)
			options
			(
	 			display field = coverage_type
	 		)
		}
	}
