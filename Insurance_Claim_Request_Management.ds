			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Claims Investigator"
			{
				name = "Claims Investigator"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Review incident descriptions and supporting documents like police reports or medical records \n"
				ModulePermissions
				{
					claim_request
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							claim_request_Report={"View","Edit","Delete"}
							claim_request_by_claim_status={"View","Edit","Delete"}
						}
					}
				}
			}
