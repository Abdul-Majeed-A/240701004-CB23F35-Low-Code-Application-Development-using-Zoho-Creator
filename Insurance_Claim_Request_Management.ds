 application "Insurance Claim Request Management"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form claim_request
		{
			displayname = "Claim Request"
			success message = "Request Claimed Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			claimant_name
			(
    			type = name
				displayname = "Claimant Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claimant_type
			(
				type = picklist
				displayname = "Claimant Type"
				values = {"Third Party","Nominee","Policyholder"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			policy_number
			(
    			type = text
				displayname = "Policy Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			email_address
			(
    			type = email
				displayname = "Email Address"
	 			row = 1
	 			column = 1   
				width = medium
			)
			contact_number
			(
    			type = phonenumber
				displayname = "Contact Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			residential_address
			(
    			type = address
				displayname = "Residential Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_type
			(
				type = picklist
				displayname = "Claim Type"
				values = {"Health Insurance","Life Insurance","Motor Insurance","Property Insurance"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			date_of_incident
			(
    			type = date
				displayname = "Date of Incident"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_amount_requested
			(
				type = number
				displayname = "Claim Amount Requested"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			supporting_documents_available
			(
				type = list	
				displayname = "Supporting Documents Available"
				values = {"Police FIR Copy","Medical Reports","Photographs","Other","Repair Estimate","Policy Document"}
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			incident_description
			(
    			type = textarea
				displayname = "Incident Description"
				height = 100px
	 			row = 1
	 			column = 1   
				width = medium
			)
			preferred_callback_time
			(
    			type = time
				displayname = "Preferred Callback Time"
				timedisplayoptions = "hh:mm:ss" 
	 			row = 1
	 			column = 1   
				width = medium
			)
			declaration_of_authenticity
			(
    			type = checkbox
				displayname = "Declaration Of Authenticity"
				initial value = false
	 			row = 1
	 			column = 1   
				width = medium
			)
			reference_number
			(
    			type = autonumber
				displayname = "Reference Number"
				start index = 1
	 			row = 1
	 			column = 1   
				width = medium
			)
			submission_date
			(
    			type = datetime
				displayname = "Submission Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			assigned_investigator
			(
    			type = text
				displayname = "Assigned Investigator"
	 			row = 1
	 			column = 1   
				width = medium
			)
			claim_status
			(
				type = picklist
				displayname = "Claim Status"
				values = {"Submitted","Under Review","Assigned","Investigated","Settled","Approved","Rejected"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Claim Draft","Claim Submitted","Claim Under Review","Claim Rejected","Claim Pending Documents","Claim Approved","Claim Processing","Claim Paid","Claim On Hold","Claim Closed"}
			}
		}
	}
	reports
	{
		list claim_request_Report
		{
			displayName = "All Requests"
			show all rows from claim_request    
			(
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				policy_number as "Policy Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents_available as "Supporting Documents Available"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				declaration_of_authenticity as "Declaration Of Authenticity"
				reference_number as "Reference Number"
				submission_date as "Submission Date"
				assigned_investigator as "Assigned Investigator"
				claim_status as "Claim Status"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (claimant_type == "Nominee")
				fields = [claimant_type]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (claimant_type == "Policyholder")
				fields = [claimant_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban claim_request_by_claim_status
		{
			displayName = "Claim Statuses"
			show all rows from claim_request    
			(
				claimant_name  as "Claimant Name"
				claimant_type as "Claimant Type"
				policy_number as "Policy Number"
				email_address as "Email Address"
				contact_number as "Contact Number"
				residential_address  as "Residential Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				claim_type as "Claim Type"
				date_of_incident as "Date of Incident"
				claim_amount_requested as "Claim Amount Requested"
				supporting_documents_available as "Supporting Documents Available"
				incident_description as "Incident Description"
				preferred_callback_time as "Preferred Callback Time"
				declaration_of_authenticity as "Declaration Of Authenticity"
				reference_number as "Reference Number"
				submission_date as "Submission Date"
				assigned_investigator as "Assigned Investigator"
				claim_status as "Claim Status"
			)
			options
			(
	 			display field = claim_status
	 		)
		}
	}
