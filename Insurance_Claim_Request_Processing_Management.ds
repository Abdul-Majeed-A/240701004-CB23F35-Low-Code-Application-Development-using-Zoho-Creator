			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Surveyor"
			{
				name = "Surveyor"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Conduct on-site inspections and update current availability status \n"
				ModulePermissions
				{
					claim_document
					{
						enabled= Viewall,Modifyall 
						allFieldsVisible= true 
						ReportPermissions
						{
							claim_document_by_document_type={"View","Edit","Delete"}
							claim_document_Report={"View","Edit","Delete"}
						}
					}
					surveyor
