		workflow
		{
		form
		{
			auto_calculate_net_payable as "Auto-calculate Net Payable"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on user input of estimated_repair_cost
				{
					actions 
					{
						custom deluge script
						(
											// Calculate net payable amount based on estimated repair cost and depreciation percent
										if(input.estimated_repair_cost.isNull() || input.depreciation_percent.isNull())
										{
											// If either field is null, set net payable to 0
											input.net_payable_amount = 0;
										}
										else
										{
											// Convert depreciation percent to decimal (divide by 100)
											depreciationDecimal = input.depreciation_percent.toDecimal() / 100;
											// Calculate net payable amount: cost * (1 - depreciation)
											netAmount = input.estimated_repair_cost * (1 - depreciationDecimal);
											// Assign the calculated value to net_payable_amount field
											input.net_payable_amount = netAmount;
										}
										// Log the calculated value for debugging
										info "Calculated net payable amount: " + input.net_payable_amount.toText();
						)
					}
				}

			}
			validate_document_completeness as "Validate Document Completeness"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if document completeness flag is not set
										if(input.is_document_complete == false)
										{
											alert "Error: Required documents are missing or incomplete. Please upload all necessary documents before submitting.";
											cancel submit;
										}
										// Validate that incident description is not blank
										if(input.incident_description.isBlank())
										{
											alert "Error: Incident description is required. Please provide a description of the incident.";
											cancel submit;
										}
										// Validate that incident date is not blank
										if(input.incident_date.isBlank())
										{
											alert "Error: Incident date is required. Please provide the date of the incident.";
											cancel submit;
										}
										// Validate claimant phone number is not blank
										if(input.claimant_phone.isBlank())
										{
											alert "Error: Claimant phone number is required. Please provide a valid phone number.";
											cancel submit;
										}
										// Validate claimant email is not blank
										if(input.claimant_email.isBlank())
										{
											alert "Error: Claimant email is required. Please provide a valid email address.";
											cancel submit;
										}
										// Validate claimant name is not blank
										if(claimant_name.first_name.isBlank() || claimant_name.last_name.isBlank())
										{
											alert "Error: Claimant name is required. Please provide both first and last name.";
											cancel submit;
										}
										// Validate address is not blank
										if(claimant_address.address_line_1.isBlank())
										{
											alert "Error: Claimant address is required. Please provide the complete address.";
											cancel submit;
										}
						)
					}
				}

			}
			notify_claimant_on_approval as "Notify Claimant on Approval"
			{
				type =  form
				form = claim_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claim request record to get claimant email
										claimRecord = claim_request[ID == input.ID];
										// Check if the claim status is Approved
										if(claimRecord.status == "Approved")
										{
											// Get claimant email from the claim request
											claimantEmail = claimRecord.claimant_email;
											// Get claimant name from the claim request
											claimantName = claimRecord.claimant_name.first_name;
											// Get claim reference ID
											claimReference = claimRecord.claim_reference_id;
											// Send email notification to the claimant
											sendmail
											[
												from :zoho.loginuserid
												to :claimantEmail
												subject :"Your Claim Has Been Approved"
												message :"Dear " + claimantName + ",\n\nYour claim with reference number " + claimReference.toString() + " has been approved.\n\nThank you for your patience.\n\nBest regards,\nInsurance Claim Processing Team"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			daily_pending_claim_reminder as "Daily Pending Claim Reminder"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch claims with status 'Pending Senior Approval'
										pendingClaims = claim_request[status == "Pending Senior Approval"];
										// Check if there are any pending claims
										if(pendingClaims.count() > 0)
										{
											// Iterate through each pending claim
											for each  claim in pendingClaims
											{
												// Construct email subject
												subject = "Daily Reminder: Claim Pending Senior Approval - " + claim.claim_reference_id.toString();
												// Construct email body with claim details
												claimantName = claim.claimant_name.first_name.concat(" ").concat(claim.claimant_name.last_name);
												message = "Dear Senior Approver,\n\n";
												message = message.concat("The following claim is pending your approval:\n\n");
												message = message.concat("Claim Reference: ").concat(claim.claim_reference_id.toString()).concat("\n");
												message = message.concat("Claimant: ").concat(claimantName).concat("\n");
												message = message.concat("Incident Date: ").concat(toString(claim.incident_date,"dd-MMM-yyyy")).concat("\n");
												message = message.concat("Estimated Repair Cost: ").concat(claim.estimated_repair_cost.toString()).concat("\n\n");
												message = message.concat("Please review and take necessary action at your earliest convenience.");
												// Send email to senior approvers (using admin user as default recipient)
												sendmail
												[
													from :zoho.loginuserid
													to :zoho.adminuserid
													subject :subject
													message :message
													content type :Plain Text
												]
											}
										}
					)
					}
				}
			}
		}


