			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Claims Approver"
			{
				name = "Claims Approver"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Review final calculations and evidence packages before authorizing claim payments \n"
				ModulePermissions
				{
					policies
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							policies_Report={"View"}
							policies_by_coverage_type={"View"}
						}
					}
					claim_request
					{
						enabled= Viewall,Modifyall,Export 
						allFieldsVisible= true 
						ReportPermissions
						{
							claim_request_Report={"View","Edit","Delete"}
						}
					}
					witness_details
					{
						enabled= Viewall 
						allFieldsVisible= true 
