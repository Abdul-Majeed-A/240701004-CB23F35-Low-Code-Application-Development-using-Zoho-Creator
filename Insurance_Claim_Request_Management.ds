		workflow
		{
		form
		{
			auto_generate_reference_number as "Auto-Generate Reference Number"
			{
				type =  form
				form = claim_request

				record event = on add

				on load
				{
					actions 
					{
						custom deluge script
						(
											// Set reference number automatically when a new claim is submitted
										// Note: reference_number is an autonumber field and cannot be manually set
										// The system will automatically generate the reference number upon record creation
										// This script can be used to set other fields that need auto-population
										// Check if this is a new record (ID is null or empty)
										if(input.ID.isNull())
										{
											// Generate a unique identifier using current date and time
											currentDateTime = zoho.currenttime;
											// Extract year, month, day, hour, minute, second
											year = currentDateTime.toString("yyyy");
											month = currentDateTime.toString("MM");
											day = currentDateTime.toString("dd");
											hour = currentDateTime.toString("HH");
											minute = currentDateTime.toString("mm");
											second = currentDateTime.toString("ss");
											// Create a unique identifier for internal use (not the autonumber field)
											uniqueId = "CLAIM-".concat(year).concat(month).concat(day).concat("-").concat(hour).concat(minute).concat(second);
											// Set other fields that can be auto-populated
											// Example: Set submission_date to current time if not already set
											if(input.submission_date.isNull())
											{
												input.submission_date = currentDateTime;
											}
											// Set added user information
											// Note: Added_User is a system field and is automatically set by the platform
											// This is just for reference
											info "New claim submitted by: " + zoho.loginuserid;
										}
						)
					}
				}

			}
			notify_assigned_investigator as "Notify Assigned Investigator"
			{
				type =  form
				form = claim_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the assigned investigator's email address from the claim request form
										// The assigned_investigator field is a text field containing the email or user identifier
										investigatorEmail = input.assigned_investigator;
										// Check if investigator email is not null or empty
										if(!investigatorEmail.isNull() && !investigatorEmail.isEmpty())
										{
											// Send email notification to the investigator
											sendmail
											[
												from :zoho.loginuserid
												to :investigatorEmail
												subject :"New Claim Assignment - " + input.reference_number
												message :"<p>Dear Investigator,</p><p>You have been assigned a new claim request.</p><p><strong>Claim Reference:</strong> " + input.reference_number + "</p><p><strong>Claim Type:</strong> " + input.claim_type + "</p><p><strong>Claim Amount:</strong> " + input.claim_amount_requested.toString() + "</p><p>Please review the claim details and take necessary action.</p>"
											]
										}
						)
					}
				}

			}
		}

		schedule
		{
			weekly_claim_status_report as "Weekly Claim Status Report"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all pending claims (Submitted, Under Review, Assigned, Investigated)
										pendingClaims = claim_request[claim_status in {"Submitted","Under Review","Assigned","Investigated"}];
										// Initialize email message
										emailSubject = "Weekly Pending Claims Summary";
										emailMessage = "<h2>Weekly Pending Claims Summary</h2>";
										// Count total pending claims
										totalPending = pendingClaims.count();
										if(totalPending > 0)
										{
											emailMessage = emailMessage.concat("<p><strong>Total Pending Claims:</strong> " + totalPending.toString() + "</p>");
											emailMessage = emailMessage.concat("<table border='1' cellpadding='5' cellspacing='0'>");
											emailMessage = emailMessage.concat("<tr><th>Reference Number</th><th>Claimant Name</th><th>Claim Type</th><th>Claim Amount</th><th>Status</th><th>Submission Date</th></tr>");
											for each  claim in pendingClaims
											{
												claimantName = "";
												if(!claim.claimant_name.isNull())
												{
													claimantName = claim.claimant_name.first_name + " " + claim.claimant_name.last_name;
												}
												emailMessage = emailMessage.concat("<tr>");
												emailMessage = emailMessage.concat("<td>" + claim.reference_number + "</td>");
												emailMessage = emailMessage.concat("<td>" + claimantName + "</td>");
												emailMessage = emailMessage.concat("<td>" + claim.claim_type + "</td>");
												emailMessage = emailMessage.concat("<td>" + claim.claim_amount_requested.toString() + "</td>");
												emailMessage = emailMessage.concat("<td>" + claim.claim_status + "</td>");
												submissionDate = "";
												if(!claim.submission_date.isNull())
												{
													submissionDate = toString(claim.submission_date,"MMM dd, yyyy","UTC");
												}
												emailMessage = emailMessage.concat("<td>" + submissionDate + "</td>");
												emailMessage = emailMessage.concat("</tr>");
											}
											emailMessage = emailMessage.concat("</table>");
										}
										else
										{
											emailMessage = emailMessage.concat("<p>No pending claims found this week.</p>");
										}
										// Send email to management
										sendmail
										[
											from :zoho.loginuserid
											to :zoho.adminuserid
											subject :emailSubject
											message :emailMessage
											content type :HTML
										]
					)
					}
				}
			}
		}


