				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (claim_type == "Life")
				fields = [claim_type]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (claim_type == "Vehicle")
				fields = [claim_type]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
			)
		}
		kanban claim_request_by_claim_type
		{
			displayName = "Claim Types"
			show all rows from claim_request    
			(
				claim_reference_id as "Claim Reference ID"
				claimant_name  as "Claimant Name"
				policy_number as "Policy Number"
				claim_type as "Claim Type"
				status as "Status"
				claim_amount as "Claim Amount"
				(
					display = total,average,min,max	
				)
				submission_date as "Submission Date"
				settlement_date as "Settlement Date"
				missing_documents_flag as "Missing Documents Flag"
				fir_document_url as "FIR Document URL"
				repair_estimate_url as "Repair Estimate URL"
				surveyor_assigned as "Surveyor Assigned"
				branch_manager as "Branch Manager"
				notes as "Notes"
			)
			options
			(
	 			display field = claim_type
	 		)
		}
