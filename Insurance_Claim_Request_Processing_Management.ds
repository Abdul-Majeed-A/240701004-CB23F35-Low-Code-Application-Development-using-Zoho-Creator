		workflow
		{
		form
		{
			block_missing_docs as "Block Submission for Missing Docs"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if missing_documents_flag is true
										if(input.missing_documents_flag == true)
										{
											// Check if any claim documents are attached
											claimDocuments = claim_document[claim.ID in input.ID];
											documentCount = claimDocuments.count();
											// If no documents are attached, throw error to cancel submission
											if(documentCount == 0)
											{
												alert(missing_documents_flag,"Cannot submit claim with missing documents flag set to true. Please upload the required documents first.");
												throw "Submission cancelled: Missing documents flag is true but no documents are attached.";
											}
										}
						)
					}
				}

			}
			notify_manager_approval as "Notify Branch Manager on Approval"
			{
				type =  form
				form = claim_request

				record event = on edit

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Fetch the claim request record that was just submitted
										claimRecord = claim_request[ID == input.ID];
										// Check if the claim status is Approved
										if(claimRecord.status == "Approved")
										{
											// Get the branch manager email from the claim record
											branchManagerEmail = claimRecord.branch_manager;
											// Get the claim reference ID and claimant name
											claimReferenceId = claimRecord.claim_reference_id;
											claimantName = claimRecord.claimant_name.first_name;
											// Prepare the email subject
											emailSubject = "Claim Approval Notification - " + claimReferenceId;
											// Prepare the email message
											emailMessage = "<p>Dear Branch Manager,</p>" + "<p>Your claim with reference ID <strong>" + claimReferenceId + "</strong> has been approved.</p>" + "<p>Claimant: " + claimantName + "</p>" + "<p>Please review the claim details in the system.</p>" + "<p>Thank you.</p>";
											// Send the email notification
											sendmail
											[
												from :zoho.loginuserid
												to :branchManagerEmail
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
						)
					}
				}

			}
		}






	}
	share_settings
