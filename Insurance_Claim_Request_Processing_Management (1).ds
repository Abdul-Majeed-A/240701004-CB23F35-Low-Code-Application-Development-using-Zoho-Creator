			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Surveyor"
			{
				name = "Surveyor"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Conduct field investigations and update claim details with on-site findings \n"
				ModulePermissions
				{
					Claim_Request_Form
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							Claim_Request_Form_Report={"View","Edit"}
							Claim_Request_Form_by_claim_type={"View","Edit"}
						}
					}
					Claims_Processing_Team
					{
						enabled= Viewall 
						allFieldsVisible= true 
						ReportPermissions
						{
							Claims_Processing_Team_by_role={"View","Edit"}
							Claims_Processing_Team_Report={"View","Edit"}
						}
					}
					Surveyor_Profile
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							Surveyor_Profile_Report={"View","Edit","Delete"}
						}
					}
				}
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			"Policyholder"
			{
				name = "Policyholder"
				type = Customer_Portal
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Submit new claim requests with incident details and required documentation \n"
				ModulePermissions
				{
					Claims_Processing_Team
					{
						allFieldsVisible= true 
						ReportPermissions
						{
							Claims_Processing_Team_by_role={"View"}
							Claims_Processing_Team_Report={"View"}
						}
					}
					Claim_Request_Form
					{
						enabled= Create,Tab 
						allFieldsVisible= true 
						ReportPermissions
						{
							Claim_Request_Form_Report={"View","Edit"}
							Claim_Request_Form_by_claim_type={"View","Edit"}
						}
					}
				}
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


