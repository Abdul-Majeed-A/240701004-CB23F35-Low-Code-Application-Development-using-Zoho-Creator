		workflow
		{
		form
		{
			auto_calculate_net_payable as "Auto-Calculate Net Payable Amount"
			{
				type =  form
				form = claim_request

				record event = on edit

				on user input of estimated_repair_cost
				{
					actions 
					{
						custom deluge script
						(
											// Calculate net payable by applying depreciation percentage to estimated repair cost
										if(input.estimated_repair_cost.isNull() || input.depreciation_percent.isNull())
										{
											// If either field is null, set net payable to 0 or leave it unchanged
											input.net_payable_amount = 0;
										}
										else
										{
											// Convert estimated repair cost to decimal for calculation
											repairCostDecimal = input.estimated_repair_cost.toDecimal();
											// Convert depreciation percent to decimal (divide by 100)
											depreciationDecimal = input.depreciation_percent.toDecimal();
											// Calculate depreciation amount
											depreciationAmount = repairCostDecimal * depreciationDecimal / 100;
											// Calculate net payable amount
											netPayable = repairCostDecimal - depreciationAmount;
											// Set the net payable amount
											input.net_payable_amount = netPayable;
										}
						)
					}
				}

			}
			validate_policy_validity as "Validate Policy Validity Before Submission"
			{
				type =  form
				form = claim_request

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if policy validity date is in the past
										if(policy_details_lookup.validity_date != null && !policy_details_lookup.validity_date.isNull())
										{
											// Get the validity date from the lookup record
											validityDate = input.policy_details_lookup.validity_date;
											// Get today's date for comparison
											currentDate = today;
											// Check if validity date is before today (in the past)
											if(validityDate < currentDate)
											{
												// Display error message to user
												alert "Submission cancelled: The policy validity date (" + validityDate + ") is in the past. Please provide a valid policy with a future validity date.";
												// Cancel the form submission
												cancel submit;
											}
										}
						)
					}
				}

			}
			notify_claimant_success as "Notify Claimant of Submission Success"
			{
				type =  form
				form = claim_request

				record event = on add

				on success
				{
					actions 
					{
						custom deluge script
						(
											// Get the claim reference ID from the submitted form
										claimRefId = input.claim_reference_id;
										// Get the claimant's email address
										claimantEmail = input.contact_email;
										// Validate that the email address is not null or empty
										if(claimantEmail.isNull())
										{
											// If email is not provided, use the logged-in user's email
											claimantEmail = zoho.loginuserid;
										}
										// Prepare the email subject
										emailSubject = "Claim Submission Confirmation - Reference ID: " + claimRefId.toString();
										// Prepare the email message body
										emailMessage = "<p>Dear Claimant,</p>" + "<p>Your insurance claim has been successfully submitted.</p>" + "<p><strong>Claim Reference ID:</strong> " + claimRefId.toString() + "</p>" + "<p>We will review your claim and get back to you shortly.</p>" + "<p>Thank you for your patience.</p>";
										// Send the confirmation email
										sendmail
										[
											from :zoho.loginuserid
											to :claimantEmail
											subject :emailSubject
											message :emailMessage
											content type :HTML
										]
										// Display success message
										success message "Claim submitted successfully. Confirmation email sent.";
						)
					}
				}

			}
		}

		schedule
		{
			daily_expired_policy_alert as "Daily Expired Policy Alert"
			{
				type =  schedule
				form = policies
					status = inactive
				start = validity_date at "10:00:00"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch the current date to compare with policy validity
										currentDate = today;
										// Get the policy validity date from input
										validityDate = input.validity_date;
										// Check if the validity date is valid and not null
										if(!validityDate.isNull())
										{
											// Calculate the date 24 hours from now
											expiryThreshold = currentDate.addDay(1);
											// Check if policy expires within 24 hours (validity date is today or tomorrow)
											if(validityDate == currentDate || validityDate == expiryThreshold)
											{
												// Prepare the notification message
												policyId = input.policy_id;
												policyHolderName = input.policy_holder_name.first_name.concat(" ").concat(input.policy_holder_name.last_name);
												expiryDate = validityDate.toString();
												message = "<p>Dear Admin,</p>";
												message = message.concat("<p>A policy is expiring within 24 hours.</p>");
												message = message.concat("<p><strong>Policy ID:</strong> " + policyId + "</p>");
												message = message.concat("<p><strong>Policy Holder:</strong> " + policyHolderName + "</p>");
												message = message.concat("<p><strong>Expiry Date:</strong> " + expiryDate + "</p>");
												message = message.concat("<p>Please take necessary action.</p>");
												// Send notification to admin users
												sendmail
												[
													from :zoho.adminuserid
													to :zoho.adminuserid
													subject :"Policy Expiry Alert - " + policyId
													message :message
													content type :HTML
												]
											}
										}
					)
					}
				}
			}
		}


