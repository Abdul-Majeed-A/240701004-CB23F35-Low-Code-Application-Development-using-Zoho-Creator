				manager_name  as "Manager Name"
				email as "Email"
				branch_code as "Branch Code"
				region as "Region"
			)
		}
		list Claims_Processing_Team_Report
		{
			displayName = "Claims Processing Team Report"
			show all rows from Claims_Processing_Team    
			(
				team_member_name  as "Team Member Name"
				email as "Email"
				role as "Role"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (role == "Senior Associate")
				fields = [role]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (role == "Team Lead")
				fields = [role]
				format = "color:#000000;background-color:#1bbc9b;"
				}
			)
		}
		kanban Claims_Processing_Team_by_role
		{
			displayName = "Roles"
			show all rows from Claims_Processing_Team    
			(
				team_member_name  as "Team Member Name"
				email as "Email"
				role as "Role"
			)
			options
